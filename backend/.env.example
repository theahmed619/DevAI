# ==========================================
# BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==========================================
# Copy this file to '.env' and update the values with your local settings:
#   cp .env.example .env

# Server port
PORT=5000

# MongoDB Connection String (MongoDB Atlas or local MongoDB)
# Example: mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
Db_url=mongodb+srv://<username>:<password>@cluster.mongodb.net/

# JWT Secret Key (Used to sign user authentication tokens)
# Generate a secure random string (e.g., using `openssl rand -base64 32`)
Jwt_sec=your_jwt_secret_key_here

# Activation/OTP Secret Key (Used if email OTP verification is enabled)
Activation_sec=your_activation_secret_key_here

# ------------------------------------------
# Optional / SMTP Email Configuration
# (Required only if sending emails/OTPs via Nodemailer)
# ------------------------------------------
# Your Gmail address:
Gmail=your_email@gmail.com

# 16-character Google App Password (NOT your regular Gmail account password)
# How to get it:
# 1. Go to Google Account -> Security (https://myaccount.google.com/security)
# 2. Turn ON 2-Step Verification
# 3. Search "App passwords" -> Create a new app password -> Copy the 16 characters
Password=your_16_character_app_password
