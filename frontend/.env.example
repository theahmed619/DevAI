# ==========================================
# FRONTEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==========================================
# Copy this file to '.env' and update the values with your local settings:
#   cp .env.example .env

# Backend API server URL
VITE_SERVER_URL=http://localhost:5000

# Google Gemini API Key (Used to generate AI chat responses)
# Get your free API key at: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Web API Key (Used for Google OAuth popup sign-in)
# Found in Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
